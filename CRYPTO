One time pad

def two_time_pad_attack(c1, c2, known_plain):
    xored = bytes([a ^ b for a, b in zip(c1, c2)])
    recovered = bytes([x ^ y for x, y in zip(xored, known_plain)])
    return recovered

# Ciphertexts (hexadecimal)
cipher1 = bytes.fromhex("0e0b0c1a")
cipher2 = bytes.fromhex("0a0f091f")

# Known plaintext of the first message
plaintext1 = b"flag"

# Recover corresponding fragment of second plaintext
recovered = two_time_pad_attack(cipher1, cipher2, plaintext1)

print("Recovered fragment:", recovered)
print("As text:", recovered.decode(errors="replace"))

